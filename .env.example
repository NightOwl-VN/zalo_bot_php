# Zalo Bot PHP SDK - Environment Variables
# Reference: https://bot.zapps.me/docs/

# Bot Token from Zalo Bot Console (REQUIRED)
# Get at: https://bot.zapps.me/ > Bot Settings
ZALO_BOT_TOKEN=YOUR_ZALO_BOT_TOKEN_HERE

# Secret Key for webhook verification (OPTIONAL, min 8 chars)
# Get at: https://bot.zapps.me/ > Bot Settings
ZALO_BOT_SECRET=YOUR_ZALO_BOT_SECRET_HERE

# Request timeout in milliseconds (default: 30000)
ZALO_BOT_TIMEOUT=30000

# Max retry attempts on transient failures (default: 3)
ZALO_BOT_MAX_RETRIES=3

# Custom API base URL (optional, default: https://bot-api.zaloplatforms.com)
# ZALO_BOT_BASE_URL=https://bot-api.zaloplatforms.com

# Server Port for webhook-server.php (default: 8080)
PORT=8080

# Test User ID (for send-message.php example)
ZALO_BOT_TEST_USER_ID=USER_ID_TO_TEST

# Attachment ID (for media-download.php example)
ZALO_BOT_ATTACHMENT_ID=ATTACHMENT_ID_HERE
